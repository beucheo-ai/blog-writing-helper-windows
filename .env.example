# 이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채우세요. (.env는 절대 공유 금지)

# [필수] 네이버 클라우드 콘솔 > NAVER API HUB > Application > 인증 정보
# (Application에 '블로그 검색' API 포함 필요)
NCP_HUB_CLIENT_ID=
NCP_HUB_CLIENT_SECRET=

# [선택] 월 검색수를 숫자로 보고 싶을 때만 채우세요. 비워 두면 검색수와 경쟁도는 비어 있어요.
# 네이버 검색광고(searchad.naver.com) > 도구 > API 사용 관리
SEARCHAD_CUSTOMER_ID=
SEARCHAD_ACCESS_LICENSE=
SEARCHAD_SECRET_KEY=
